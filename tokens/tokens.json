{
  "color": {
    "chili":       { "value": "#ff3030", "source": "logo",    "use": "The brand red. Lit face of the chili. Buttons, highlights, the selected item." },
    "chili-shade": { "value": "#e42020", "source": "logo",    "use": "Shaded face of the chili. Pressed and hover states, the second facet of a shape." },
    "leaf":        { "value": "#2eac00", "source": "logo",    "use": "The stem. Second brand colour. Success, 'go', small accents." },
    "chili-deep":  { "value": "#4c0710", "source": "derived", "use": "Very dark chili. Hard shadows under red elements." },
    "chili-ink":   { "value": "#c81616", "source": "derived", "use": "Chili for text on light backgrounds." },
    "leaf-bright": { "value": "#6fe33a", "source": "derived", "use": "Leaf for text, links and focus rings on dark backgrounds." },
    "leaf-ink":    { "value": "#1e7300", "source": "derived", "use": "Leaf for text and links on light backgrounds." },
    "amber":       { "value": "#ffb347", "source": "support", "use": "Warnings. Not a brand colour." },
    "amber-ink":   { "value": "#8a5200", "source": "support", "use": "Warning text on light backgrounds." },
    "black":       { "value": "#000000", "source": "neutral", "use": "Console screen background. Pixels that are off." },
    "ink-0":       { "value": "#07080c", "source": "neutral", "use": "Page background, dark theme." },
    "ink-1":       { "value": "#0c0f14", "source": "neutral", "use": "Sunken areas, dark theme." },
    "ink-2":       { "value": "#10131a", "source": "neutral", "use": "Cards and panels, dark theme. Body text, light theme." },
    "ink-3":       { "value": "#171b24", "source": "neutral", "use": "Raised or hovered surfaces, dark theme." },
    "ink-4":       { "value": "#262c38", "source": "neutral", "use": "Borders and dividers, dark theme." },
    "slate":       { "value": "#565e6e", "source": "neutral", "use": "Secondary text, light theme." },
    "mist":        { "value": "#9aa3b5", "source": "neutral", "use": "Secondary text, dark theme." },
    "sand":        { "value": "#d8d3c7", "source": "neutral", "use": "Borders and dividers, light theme." },
    "bone":        { "value": "#f4f1ea", "source": "neutral", "use": "Body text, dark theme. Page background, light theme." },
    "paper":       { "value": "#ffffff", "source": "neutral", "use": "Cards and panels, light theme." },
    "on-chili":    { "value": "#140407", "source": "neutral", "use": "Text and icons on a chili fill." }
  },
  "theme": {
    "dark": {
      "bg": "ink-0", "surface": "ink-2", "surface-raised": "ink-3", "surface-sunken": "ink-1",
      "line": "ink-4", "text": "bone", "muted": "mist",
      "accent": "chili", "accent-shade": "chili-shade", "accent-deep": "chili-deep",
      "accent-text": "chili", "on-accent": "on-chili",
      "link": "leaf-bright", "focus": "leaf-bright",
      "success": "leaf-bright", "warning": "amber", "danger": "chili"
    },
    "light": {
      "bg": "bone", "surface": "paper", "surface-raised": "paper", "surface-sunken": "sand",
      "line": "sand", "text": "ink-2", "muted": "slate",
      "accent": "chili", "accent-shade": "chili-shade", "accent-deep": "chili-deep",
      "accent-text": "chili-ink", "on-accent": "on-chili",
      "link": "leaf-ink", "focus": "leaf-ink",
      "success": "leaf-ink", "warning": "amber-ink", "danger": "chili-ink"
    },
    "console": {
      "bg": "black", "surface": "ink-2", "line": "ink-4", "text": "bone", "muted": "mist",
      "accent": "chili", "accent-shade": "chili-shade", "on-accent": "on-chili",
      "success": "leaf", "warning": "amber", "danger": "chili"
    }
  },
  "font": {
    "display": "'Syne', ui-sans-serif, system-ui, sans-serif",
    "text": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace",
    "pixel": "'Press Start 2P', monospace"
  },
  "text": {
    "3xs": "0.58rem", "2xs": "0.68rem", "xs": "0.75rem", "sm": "0.85rem", "md": "1rem",
    "lg": "1.2rem", "xl": "1.4rem", "2xl": "clamp(1.6rem, 3vw, 2.2rem)", "3xl": "clamp(2rem, 4vw, 3.2rem)"
  },
  "leading": { "tight": "1.2", "normal": "1.5", "loose": "1.65" },
  "tracking": { "label": "0.08em", "wide": "0.12em" },
  "space": {
    "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem",
    "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem"
  },
  "radius": { "none": "0", "pill": "999px" },
  "cut": { "sm": "6px", "md": "12px" },
  "shadow": {
    "button": "4px 4px 0 var(--cc-accent-deep)",
    "card": "6px 6px 0 rgb(255 48 48 / 0.12)",
    "pop": "8px 8px 0 rgb(255 48 48 / 0.16)"
  },
  "motion": { "fast": "0.12s", "normal": "0.2s", "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)" }
}
